<?xml version="1.0" ?>
<!--
  large_world：200×200m 大型测试环境
  机器人出生点：(-95, -95)，朝东北方向（yaw=0.785 rad）

  设计特点：
    - 200×200m 大场地，测试远距离感知与路径规划
    - 混合障碍类型：横墙、竖墙、圆柱、箱子、L形
    - 20 个障碍分散分布，间距 > 10m，不形成凹坑
    - 出生点在西南角，目标可设在东北角（远距离导航测试）

  坐标约定：X=东，Y=北，Z=上；pose = x y z roll pitch yaw
-->
<sdf version="1.6">
  <world name="large_world">

    <!-- ====== 物理引擎 ====== -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ====== 光照 ====== -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ====== 地面（200×200m）====== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== 边界围墙（±100m，高 2m，厚 0.2m）====== -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 100.1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>200.4 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>200.4 0.2 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -100.1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>200.4 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>200.4 0.2 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>100.1 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 200.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 200.0 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-100.1 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 200.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 200.0 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ======================================================= -->
    <!-- ====== 西南区（靠近出生点）====== -->
    <!-- ======================================================= -->

    <!-- 圆柱 r=1m：(-80, -80) -->
    <model name="cyl_sw_1">
      <static>true</static>
      <pose>-80 -80 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>1.0</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.0</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 横墙 8m：(-70, -70) -->
    <model name="wall_h_sw">
      <static>true</static>
      <pose>-70 -70 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 0.3 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.3 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 竖墙 6m：(-60, -90) -->
    <model name="wall_v_sw">
      <static>true</static>
      <pose>-60 -90 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 6.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 6.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ======================================================= -->
    <!-- ====== 中心区 ====== -->
    <!-- ======================================================= -->

    <!-- 大箱子 3×3m：(0, 0) -->
    <model name="box_center">
      <static>true</static>
      <pose>0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 3.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 3.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 长横墙 15m：(20, 10) -->
    <model name="wall_h_center">
      <static>true</static>
      <pose>20 10 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>15.0 0.3 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>15.0 0.3 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 长竖墙 12m：(-20, 30) -->
    <model name="wall_v_center">
      <static>true</static>
      <pose>-20 30 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 12.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 12.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 大圆柱 r=2m：(10, -20) -->
    <model name="cyl_center">
      <static>true</static>
      <pose>10 -20 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>2.0</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>2.0</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- L形障碍：(30, -10) -->
    <model name="l_shape">
      <static>true</static>
      <pose>30 -10 0.75 0 0 0</pose>
      <link name="link">
        <!-- 东西臂 -->
        <collision name="col_h"><pose>0 0 0 0 0 0</pose><geometry><box><size>4.0 0.3 1.5</size></box></geometry></collision>
        <visual name="vis_h"><pose>0 0 0 0 0 0</pose><geometry><box><size>4.0 0.3 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
        <!-- 南北臂 -->
        <collision name="col_v"><pose>-1.85 2.0 0 0 0 0</pose><geometry><box><size>0.3 4.0 1.5</size></box></geometry></collision>
        <visual name="vis_v"><pose>-1.85 2.0 0 0 0 0</pose><geometry><box><size>0.3 4.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ======================================================= -->
    <!-- ====== 东北区 ====== -->
    <!-- ======================================================= -->

    <!-- 横墙 10m：(60, 50) -->
    <model name="wall_h_ne">
      <static>true</static>
      <pose>60 50 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.0 0.3 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.3 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 竖墙 8m：(80, 70) -->
    <model name="wall_v_ne">
      <static>true</static>
      <pose>80 70 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 8.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 8.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 圆柱 r=1.5m：(50, 80) -->
    <model name="cyl_ne">
      <static>true</static>
      <pose>50 80 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>1.5</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.5</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 箱子 2×2m：(70, 40) -->
    <model name="box_ne">
      <static>true</static>
      <pose>70 40 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 2.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 2.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ======================================================= -->
    <!-- ====== 边缘区 ====== -->
    <!-- ======================================================= -->

    <!-- 长横墙 20m：(0, 90) 靠近北边界 -->
    <model name="wall_h_north_edge">
      <static>true</static>
      <pose>0 90 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.0 0.3 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.0 0.3 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 长竖墙 15m：(90, 0) 靠近东边界 -->
    <model name="wall_v_east_edge">
      <static>true</static>
      <pose>90 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 15.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 15.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 圆柱 r=1m：(-90, 50) 靠近西边界 -->
    <model name="cyl_west_edge">
      <static>true</static>
      <pose>-90 50 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>1.0</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.0</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 大箱子 4×4m：(-50, -90) 靠近南边界 -->
    <model name="box_south_edge">
      <static>true</static>
      <pose>-50 -90 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 4.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.0 4.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ======================================================= -->
    <!-- ====== 额外分散障碍 ====== -->
    <!-- ======================================================= -->

    <!-- 圆柱 r=0.8m：(-40, -40) -->
    <model name="cyl_mid_sw">
      <static>true</static>
      <pose>-40 -40 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.8</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.8</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 横墙 6m：(40, -60) -->
    <model name="wall_h_se">
      <static>true</static>
      <pose>40 -60 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 0.3 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.3 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 竖墙 5m：(-30, 60) -->
    <model name="wall_v_nw">
      <static>true</static>
      <pose>-30 60 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 5.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 5.0 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- 圆柱 r=1.2m：(70, -50) -->
    <model name="cyl_se">
      <static>true</static>
      <pose>70 -50 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>1.2</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.2</radius><length>1.5</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
