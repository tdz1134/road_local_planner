<?xml version="1.0" ?>
<!--
  AUTO-GENERATED by scripts/gen_road_world.py —— 请勿手改本文件；
  改道路形状请编辑脚本顶部 PRESETS['loop'] 后重跑：
      python3 scripts/gen_road_world.py -p loop
  （注：XML 注释内不得出现连续两短横，故此处用单短横别名 -p）

  loop：首尾闭合的纯道路世界（无障碍），含 直道 + 小曲率缓弯 + 适中 U 形弯。
  路宽 6.0m，配 inflation_radius 0.7 → 净通行约 4.6m。
  中心线数值积分闭合残差 0.000m（设计为点对称闭合）。
  出生点 (2.0, 0.0) 朝 yaw=0.00rad（沿第一段直道）。

  提示：本世界同时用于两套 launch ——
    · 无定位沿路：loop_road.launch（follow_road=true，跟路缘走廊）
    · 有定位终点：loop_goal.launch （follow_road=false，RViz 点 2D Nav Goal）
-->
<sdf version="1.6">
  <world name="loop_road">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <include><uri>model://sun</uri></include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
          <geometry><plane><normal>0 0 1</normal>
            <size>120 120</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal>
            <size>120 120</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

