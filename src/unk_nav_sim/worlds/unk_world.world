<?xml version="1.0" ?>
<!--
  unk_nav 测试世界：30×30m 室内场地
  机器人出生点：(0, 0, 0)，朝 +X 方向

  障碍设计原则（unk_nav 能力边界）：
    ✓ 所有障碍均为凸形（柱/墙/箱），机器人可绕行
    ✗ 禁止 U 形凹坑（unk_nav 的 BOUNDARY_FOLLOW 已取消，遇凹形会 ABORT）
    ✗ 禁止障碍物之间形成 < 1m 窄缝（机器人半宽 0.29m，缝隙太小会卡住）

  坐标约定：
    X: 右（东）  Y: 前（北）  Z: 上
    pose 格式: x y z roll pitch yaw
-->
<sdf version="1.6">
  <world name="unk_world">

    <!-- ====== 物理引擎 ====== -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ====== 光照 ====== -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ====== 地面 ====== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== 边界墙（高 2m，厚 0.2m）====== -->

    <!-- 北墙 y=+15 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 15.1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30.4 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.4 0.2 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 南墙 y=-15 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -15.1 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30.4 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.4 0.2 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 东墙 x=+15 -->
    <model name="wall_east">
      <static>true</static>
      <pose>15.1 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 30.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 30.0 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 西墙 x=-15 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-15.1 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 30.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 30.0 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== 障碍物 ====== -->

    <!--
      柱子1：(4, 2)  距出生点 ~4.5m
      第一个感知到的障碍，测试基础绕行
    -->
    <model name="pillar_1">
      <static>true</static>
      <pose>4 2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      横墙：(7, 6)  长 6m，东西走向
      测试横向 LOS 遮挡 + 绕行选路
    -->
    <model name="wall_horiz">
      <static>true</static>
      <pose>7 6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.2 1.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Orange</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      箱子：(-6, 4)  1.5×1.5×1.5m
      测试方形障碍绕行
    -->
    <model name="box_1">
      <static>true</static>
      <pose>-6 4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.5 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      L 形障碍：(3, -7)
      东西臂 4m + 南北臂 4m（凸形外角，不形成凹坑）
      测试拐角感知与路径选择
    -->
    <model name="l_shape">
      <static>true</static>
      <pose>3 -7 0.75 0 0 0</pose>
      <link name="link">
        <!-- 东西向臂 -->
        <collision name="col_h">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>4.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="vis_h">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>4.0 0.2 1.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Yellow</name>
            </script>
          </material>
        </visual>
        <!-- 南北向臂 -->
        <collision name="col_v">
          <pose>-1.9 2.0 0 0 0 0</pose>
          <geometry><box><size>0.2 4.0 1.5</size></box></geometry>
        </collision>
        <visual name="vis_v">
          <pose>-1.9 2.0 0 0 0 0</pose>
          <geometry><box><size>0.2 4.0 1.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Yellow</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      柱子2：(-8, -6)  半径 0.4m
      西南区域障碍
    -->
    <model name="pillar_2">
      <static>true</static>
      <pose>-8 -6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.4</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.5</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      竖墙：(11, -4)  长 5m，南北走向
      测试纵向 LOS 遮挡
    -->
    <model name="wall_vert">
      <static>true</static>
      <pose>11 -4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 5.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 5.0 1.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Orange</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      柱子3：(-3, 10)  半径 0.3m
      北部区域障碍
    -->
    <model name="pillar_3">
      <static>true</static>
      <pose>-3 10 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      柱子4：(9, 10)  半径 0.25m
      东北角障碍
    -->
    <model name="pillar_4">
      <static>true</static>
      <pose>9 10 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!--
      柱子5：(0, -12)  半径 0.35m
      南部障碍，测试远距离感知
    -->
    <model name="pillar_5">
      <static>true</static>
      <pose>0 -12 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
