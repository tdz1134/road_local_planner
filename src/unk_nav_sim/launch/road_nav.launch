<?xml version="1.0"?>
<!--
  road_nav.launch：有定位、有终点的走廊导航（与 road_follow.launch 同场景）
  一键启动：Gazebo(road_world 走廊) + Scout v2 + 定位 + 栅格 + 导航(终点模式) + RViz

  与 road_follow.launch 的区别：
    · 世界：相同 road_world（两侧路缘夹出的走廊 + 路中圆柱 + 90° 弯）
    · 定位：必须启动 localization_node（Gazebo 真值 → /odom + TF）
    · 导航配置：nav_params.yaml（follow_road=false）—— NavCore 用「全局终点
      经定位投影」得子目标，需要 pose + goal
    · RViz：unk_nav.rviz（Fixed Frame=odom；用 "2D Nav Goal" 点终点）

  用法：
    1. roslaunch unk_nav_sim road_nav.launch
    2. 在 RViz 工具栏点 "2D Nav Goal"，在走廊中点一个终点
    3. 车朝终点导航，遇到路中圆柱会绕行

  可选参数：
    gui:=false   无头模式
    x/y/yaw      出生位姿（默认走廊西端，车头朝 +X）
-->
<launch>

  <arg name="gui" default="true"/>

  <!-- 出生点：水平走廊西端，车头朝 +X（沿走廊向东）-->
  <arg name="x"   default="-20.0"/>
  <arg name="y"   default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 1. Gazebo + road_world（走廊道路）                          -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(find unk_nav_sim)/worlds/road_world.world"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 2. Scout v2（含 Velodyne HDL-32E + robot_state_publisher）  -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <include file="$(find scout_gazebo_sim)/launch/spawn_scout_v2.launch">
    <arg name="x"   value="$(arg x)"/>
    <arg name="y"   value="$(arg y)"/>
    <arg name="z"   value="0.0"/>
    <arg name="yaw" value="$(arg yaw)"/>
  </include>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 3. 定位节点（Gazebo 真值 → /odom + TF）                    -->
  <!--    终点模式必须：NavCore 需要 pose 把全局终点换算到车体系     -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="localization_node" pkg="unk_nav_sim" type="localization_node"
        output="screen">
    <param name="model_name" value="scout/"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 4. 栅格节点（/velodyne_points → /local_grid，base_link 系）  -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="grid_node" pkg="unk_nav_sim" type="grid_node" output="screen">
    <rosparam file="$(find unk_nav_sim)/config/grid_params.yaml" command="load"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 5. 导航节点（终点模式：nav_params.yaml，follow_road=false）  -->
  <!--    在 RViz 用 "2D Nav Goal" 点终点 → /move_base_simple/goal -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="nav_node" pkg="unk_nav_sim" type="nav_node" output="screen">
    <param name="config_file" value="$(find unk_nav)/config/nav_params.yaml"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 6. RViz（Fixed Frame=odom，全局视角；“2D Nav Goal” 点终点）  -->
  <!--    含 WorkGrid/PlanPath/NavState/FanCandidates 等调试话题               -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find unk_nav_sim)/config/unk_nav.rviz"
        required="false"/>

</launch>
