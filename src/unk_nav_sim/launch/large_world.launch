<?xml version="1.0"?>
<!--
  large_world 启动文件：200×200m 大型测试环境 + Scout v2
  用法：roslaunch unk_nav_sim large_world.launch
  可选参数：
    x:=-95 y:=-95 yaw:=0.785   默认出生点在西南角，朝东北
    gui:=false                  无头模式（不开 Gazebo 图形界面）
-->
<launch>

  <arg name="world_file" default="$(find unk_nav_sim)/worlds/large_world.world"/>
  <arg name="robot_namespace" default="/"/>
  <arg name="gui" default="true"/>

  <!-- 机器人出生位置（默认西南角，朝东北） -->
  <arg name="x"   default="-95.0"/>
  <arg name="y"   default="-95.0"/>
  <arg name="z"   default="0.0"/>
  <arg name="yaw" default="0.785"/>

  <!-- ====== 启动 Gazebo（加载 large_world）====== -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world_file)"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- ====== 生成 Scout v2（含 Velodyne HDL-32E）====== -->
  <include file="$(find scout_gazebo_sim)/launch/spawn_scout_v2.launch">
    <arg name="x"   value="$(arg x)"/>
    <arg name="y"   value="$(arg y)"/>
    <arg name="z"   value="$(arg z)"/>
    <arg name="yaw" value="$(arg yaw)"/>
    <arg name="robot_namespace" value="$(arg robot_namespace)"/>
  </include>

  <!-- ====== RViz（含 /velodyne_points 点云显示）====== -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find unk_nav_sim)/config/unk_nav.rviz"
        required="false"/>

</launch>
