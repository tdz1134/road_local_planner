<?xml version="1.0"?>
<!--
  loop_extreme_goal.launch：有定位 + 终点导航（follow_road=false），世界为极端闭合环道路

  世界：loop_extreme.world —— 由 scripts/gen_road_world.py -p extreme 生成的
        极端闭合环：路宽 3.0m（净通行仅 1.6m）+ S形chicane(R3 左右背靠背 90°)
        + 180°发夹弯(R=2.5)，首尾闭合、无障碍。

  与 loop_extreme_road.launch（无定位沿路）的区别：
    · 始终启动 localization_node：Gazebo 真值 → /odom + TF(odom→base_link)。
    · 导航配置：nav_params.yaml（follow_road=false）—— RViz 点全局终点，
      经定位投影成车体系子目标，走扇形选向 + A*（绕障）+ 纯跟踪。

  ⚠ 本场景是能力边界测试：
    · 车不会自动沿路绕圈，需沿走廊点一连串 2D Nav Goal 才能贴着走；
      若终点隔着路缘墙/发夹，A* 只能搜到窗口内，超窗子目标会被截断。
    · 路宽 3m 对 inflation_radius 敏感：0.7 可用（净 1.6m），≥1.0 走廊封死。
    · 发夹处预期看到扇形/软代价/吸附的联合作用，甚至 RECOVERY→自动恢复。

  用法：
    roslaunch unk_nav_sim loop_extreme_goal.launch
    roslaunch unk_nav_sim loop_extreme_goal.launch gui:=false
    在 RViz 工具栏点 "2D Nav Goal" 设定终点（Fixed Frame=odom）。
-->
<launch>

  <arg name="gui" default="true"/>

  <!-- 出生点：第一段 15m 直道上，车头朝 +X。与 world 的 SPAWN 一致 -->
  <arg name="x"   default="2.0"/>
  <arg name="y"   default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 1. Gazebo + loop_extreme（极端闭合环道路）                  -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(find unk_nav_sim)/worlds/loop_extreme.world"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 2. Scout v2（含 Velodyne HDL-32E + robot_state_publisher）  -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <include file="$(find scout_gazebo_sim)/launch/spawn_scout_v2.launch">
    <arg name="x"   value="$(arg x)"/>
    <arg name="y"   value="$(arg y)"/>
    <arg name="z"   value="0.0"/>
    <arg name="yaw" value="$(arg yaw)"/>
  </include>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 3. 定位节点（Gazebo 真值 → /odom + TF）                    -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="localization_node" pkg="unk_nav_sim" type="localization_node"
        output="screen">
    <param name="model_name" value="scout/"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 4. 栅格节点（/velodyne_points → /local_grid）              -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="grid_node" pkg="unk_nav_sim" type="grid_node" output="screen">
    <rosparam file="$(find unk_nav_sim)/config/grid_params.yaml" command="load"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 5. 导航节点（终点模式：nav_params.yaml，follow_road=false）  -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="nav_node" pkg="unk_nav_sim" type="nav_node" output="screen">
    <param name="config_file" value="$(find unk_nav)/config/nav_params.yaml"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 6. RViz（Fixed Frame=odom，全局终点导航）                   -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find unk_nav_sim)/config/unk_nav.rviz"
        required="false"/>

</launch>
