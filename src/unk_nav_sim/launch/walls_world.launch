<?xml version="1.0"?>
<!--
  walls_world 启动文件：加载纯墙壁世界 + 生成 Scout v2
  用法：roslaunch unk_nav_sim walls_world.launch
  可选参数：
    x:=5 y:=5 yaw:=1.57   改变机器人出生位置/朝向（yaw 单位 rad）
    gui:=false            无头模式（不开 Gazebo 图形界面）
-->
<launch>

  <arg name="world_file" default="$(find unk_nav_sim)/worlds/walls_world.world"/>
  <arg name="robot_namespace" default="/"/>
  <arg name="gui" default="true"/>

  <!-- 机器人出生位置（世界坐标） -->
  <arg name="x"   default="0.0"/>
  <arg name="y"   default="0.0"/>
  <arg name="z"   default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <!-- ====== 启动 Gazebo（加载 walls_world）====== -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world_file)"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- ====== 生成 Scout v2（含 Velodyne HDL-32E）====== -->
  <include file="$(find scout_gazebo_sim)/launch/spawn_scout_v2.launch">
    <arg name="x"   value="$(arg x)"/>
    <arg name="y"   value="$(arg y)"/>
    <arg name="z"   value="$(arg z)"/>
    <arg name="yaw" value="$(arg yaw)"/>
    <arg name="robot_namespace" value="$(arg robot_namespace)"/>
  </include>

  <!-- ====== RViz（含 /velodyne_points 点云显示）====== -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find unk_nav_sim)/config/unk_nav.rviz"
        required="false"/>

</launch>
