<?xml version="1.0"?>
<!--
  road_follow.launch：无定位、基于栅格走廊的沿路行驶（路线 A）
  一键启动：Gazebo(road_world 走廊) + Scout v2 + 栅格 + 导航(沿路模式) + RViz

  与 unk_nav_test.launch（终点导航）的区别：
    · 世界：road_world（两侧路缘夹出的走廊 + 路中圆柱 + 90° 弯）
    · 导航配置：nav_params_road.yaml（follow_road=true）—— NavCore 从走廊几何直接推
      车体系前瞻子目标，**完全不读定位/全局终点**
    · 默认不启动 localization_node（体现"无定位"）：规划只用 base 系栅格；无 /odom 时
      车速按 0 处理、前进位移棘轮退化为仅"规划连续失败"检测（走廊内规划恒成功，不影响跟路）。
      要 body 系车速（本体感知）与 RViz 真值可视化，设 use_localization:=true。
    · RViz 用 road_follow.rviz（Fixed Frame=base_link；沿路模式路径以 base_link 系发布）

  用法：
    roslaunch unk_nav_sim road_follow.launch
    roslaunch unk_nav_sim road_follow.launch use_localization:=true   # 供车速 + odom 真值可视化
    roslaunch unk_nav_sim road_follow.launch gui:=false               # 无头模式
-->
<launch>

  <arg name="gui" default="true"/>
  <arg name="use_localization" default="false"/>

  <!-- 出生点：水平走廊西端，车头朝 +X（沿走廊向东）-->
  <arg name="x"   default="-20.0"/>
  <arg name="y"   default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 1. Gazebo + road_world（走廊道路）                          -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(find unk_nav_sim)/worlds/road_world.world"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 2. Scout v2（含 Velodyne HDL-32E + robot_state_publisher）  -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <include file="$(find scout_gazebo_sim)/launch/spawn_scout_v2.launch">
    <arg name="x"   value="$(arg x)"/>
    <arg name="y"   value="$(arg y)"/>
    <arg name="z"   value="0.0"/>
    <arg name="yaw" value="$(arg yaw)"/>
  </include>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 3. 定位（可选）：仅供 body 系车速与 RViz 真值可视化；        -->
  <!--    沿路规划不读 pose，关掉它才是"无定位"的完整体现          -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="localization_node" pkg="unk_nav_sim" type="localization_node"
        output="screen" if="$(arg use_localization)">
    <param name="model_name" value="scout/"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 4. 栅格节点（/velodyne_points → /local_grid，base_link 系）  -->
  <!--    用静态 TF velodyne→base_link，不需要定位                 -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="grid_node" pkg="unk_nav_sim" type="grid_node" output="screen">
    <rosparam file="$(find unk_nav_sim)/config/grid_params.yaml" command="load"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 5. 导航节点（沿路模式：nav_params_road.yaml，follow_road=true）-->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="nav_node" pkg="unk_nav_sim" type="nav_node" output="screen">
    <param name="config_file" value="$(find unk_nav)/config/nav_params_road.yaml"/>
  </node>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- 6. RViz（Fixed Frame=base_link，车在原点、走廊随车滚动）     -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find unk_nav_sim)/config/road_follow.rviz"
        required="false"/>

</launch>
